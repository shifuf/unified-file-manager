# Place in the public server's nginx http context. The existing certificate
# and container port should match this deployment. Cloud source domains are
# deliberately absent: Nest streams verified replicas through this hostname.
server {
    listen 80;
    server_name files.shifuf.com;
    return 308 https://files.shifuf.com$request_uri;
}
server {
    listen 443 ssl;
    server_name files.shifuf.com;
    ssl_certificate /etc/letsencrypt/live/files.shifuf.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/files.shifuf.com/privkey.pem;
    client_max_body_size 0;
    location / {
        proxy_pass http://127.0.0.1:60558;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
