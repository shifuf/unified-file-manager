ARG UFM_VERSION=0.2.0
ARG NPM_REGISTRY=https://registry.npmmirror.com

FROM node:22-alpine AS build
ARG UFM_VERSION
ARG NPM_REGISTRY
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund --registry="$NPM_REGISTRY"
COPY web/ ./
RUN npm run build

FROM nginx:1.28-alpine
ARG UFM_VERSION
COPY --from=build /src/web/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
RUN rm /etc/nginx/conf.d/default.conf && sed -i 's@include /etc/nginx/conf.d/\*.conf;@include /tmp/nginx-conf/*.conf;@' /etc/nginx/nginx.conf
LABEL org.opencontainers.image.version="$UFM_VERSION"
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
