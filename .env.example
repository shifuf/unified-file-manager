# cp .env.example .env

NODE_ENV=development
TZ=Asia/Shanghai
APP_PORT=60557
WEB_PORT=60558
REQUIRE_HTTPS=false
ADMIN_LOGIN_PATH=/console-login
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=unified_file_manager
MYSQL_USER=ufm
PUBLIC_FILE_ALLOWED_DOMAINS=localhost,127.0.0.1
MAX_FILE_SIZE_MB=200
RECYCLE_RETENTION_DAYS=30

# 生产必改
JWT_SECRET=replace-with-at-least-32-random-characters
APP_CRYPTO_KEY=replace-with-32-byte-base64-key
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PASSWORD=ufm_password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@Strong9x
MEILI_MASTER_KEY=ufm_meili_change_me

# 可选：固定站点域名时再填（IP 访问可不写，自动用当前 Host）
# PUBLIC_URL=https://files.example.com
