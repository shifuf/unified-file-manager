# cp .env.example .env

NODE_ENV=development
TZ=Asia/Shanghai
APP_PORT=60557
WEB_PORT=60558
REQUIRE_HTTPS=false
ADMIN_LOGIN_PATH=/console-login
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=unified_file_manager
MYSQL_USER=ufm
PUBLIC_FILE_ALLOWED_DOMAINS=localhost,127.0.0.1
MAX_FILE_SIZE_MB=200
# 管理员云端文件下载/拉取的单文件临时空间上限（字节）；普通导入同时受上传限制约束。
REMOTE_FILE_MAX_BYTES=536870912
# 单个云端文件的下载时限（毫秒），默认及最长 30 分钟，最短 1 秒。
REMOTE_FILE_TIMEOUT_MS=1800000
# 可选：独立临时目录，默认使用操作系统临时目录下的 unified-file-manager-remote。
# REMOTE_FILE_TEMP_ROOT=
RECYCLE_RETENTION_DAYS=30

# 生产必改
JWT_SECRET=replace-with-at-least-32-random-characters
APP_CRYPTO_KEY=replace-with-32-byte-base64-key
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PASSWORD=ufm_password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@Strong9x
MEILI_MASTER_KEY=ufm_meili_change_me

# 可选：固定站点域名时再填（IP 访问可不写，自动用当前 Host）
# PUBLIC_URL=https://files.example.com

# Optional public release metadata endpoint (JSON tag_name/version/name).
UPDATE_CHECK_URL=https://ghcr.nju.edu.cn/v2/shifuf/unified-file-manager-api/tags/list
# Uploaded storage plugins (trusted administrator code); persist across application upgrades.
STORAGE_PLUGIN_DIR=./storage-plugins
BIND_IP=127.0.0.1
API_MEMORY_LIMIT=512m
WEB_MEMORY_LIMIT=64m
MYSQL_MEMORY_LIMIT=512m
# Keep binary logging enabled while limiting its disk usage. Values are configurable.
# MINIMAL records primary keys and changed fields; set FULL for consumers requiring full rows.
MYSQL_BINLOG_ROW_IMAGE=MINIMAL
MYSQL_BINLOG_EXPIRE_LOGS_SECONDS=259200
MYSQL_MAX_BINLOG_SIZE=67108864
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
REDIS_MEMORY_LIMIT=96m
MEILI_MEMORY_LIMIT=256m
# Preserve existing VIDEO_TRANSCODE_ENABLED / VIDEO_HLS_ENABLED / PUBLIC_URL during upgrade.
