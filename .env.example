# Copy to .env locally. Never commit .env; blank values intentionally fail startup.
UFM_DB_URL=jdbc:postgresql://localhost:5432/ufm
UFM_DB_USER=ufm
UFM_DB_PASSWORD=
UFM_DB_POOL_SIZE=8
# Generate two independent 32-byte base64 values; never reuse this template as credentials.
UFM_JWT_SECRET=
UFM_CRYPTO_KEY=
UFM_COOKIE_SECURE=true
UFM_PUBLIC_SCHEME=https
# 可选：对外访问基址（如 https://ufm.example.com），用于给第三方 Office 预览服务签发一次性取件地址。
# 留空时按反向代理的 X-Forwarded-* 请求头推导。
UFM_PUBLIC_BASE_URL=
# Compose exposes only the web listener; terminate TLS on this host.
UFM_BIND_ADDRESS=127.0.0.1
UFM_HTTP_PORT=8088
UFM_BACKUP_PATH=/data/backups
# release-update.sh 会按 Release 标签设置运行版本；源码构建可保持默认值。
# UFM_VERSION=0.2.0
# Optional release images. Leave unset to build the local Dockerfiles.
# UFM_SERVER_IMAGE=registry.example/ufm-server:version
# UFM_WEB_IMAGE=registry.example/ufm-web:version
