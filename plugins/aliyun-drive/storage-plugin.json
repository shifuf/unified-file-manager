{
  "id": "ALIYUN_DRIVE",
  "name": "阿里云盘",
  "version": "1.3.1",
  "apiVersion": 1,
  "entry": "index.cjs",
  "description": "扫码连接阿里云盘，按项目名称整理备份并支持管理员浏览、下载和拉取云端文件。",
  "capabilities": { "directUpload": false, "usage": true, "authentication": true, "backupOnly": true, "remoteFiles": true },
  "fields": [
    { "key": "accountId", "label": "网盘账号", "type": "string", "required": true, "hidden": true, "immutable": true },
    { "key": "driveId", "label": "云盘", "type": "string", "required": true, "hidden": true, "immutable": true },
    { "key": "rootFolderId", "label": "保存目录 ID", "type": "string", "default": "root", "immutable": true, "description": "默认 root。在此目录内按项目名称创建目录；系统备份使用 UFM 对象目录。保存配置后不可更换，以保证已有文件可访问。" }
  ]
}
