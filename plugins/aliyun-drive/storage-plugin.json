{
  "id": "ALIYUN_DRIVE",
  "name": "阿里云盘",
  "version": "1.1.0",
  "apiVersion": 1,
  "entry": "index.cjs",
  "description": "扫码连接阿里云盘，仅用于文件备份，不提供内容下载。",
  "capabilities": { "directUpload": false, "usage": true, "authentication": true, "backupOnly": true },
  "fields": [
    { "key": "accountId", "label": "网盘账号", "type": "string", "required": true, "hidden": true, "immutable": true },
    { "key": "driveId", "label": "云盘", "type": "string", "required": true, "hidden": true, "immutable": true },
    { "key": "rootFolderId", "label": "保存目录 ID", "type": "string", "default": "root", "immutable": true, "description": "默认 root。在此目录内自动创建 UFM 对象目录。保存配置后不可更换，以保证已有文件可访问。" }
  ]
}
