{
  "name": "unified-file-manager",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "description": "Multi-project unified file management platform.",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/sdk-js",
    "packages/storage-plugin-sdk",
    "plugins/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build:plugin-sdk && npm --workspace apps/api run build && npm --workspace apps/web run build && npm --workspace packages/sdk-js run build",
    "build:plugin-sdk": "npm --workspace packages/storage-plugin-sdk run build",
    "build:plugins": "npm run build:plugin-sdk && node plugins/build.cjs",
    "plugins:install": "npm run build:plugins && node scripts/install-storage-plugins.cjs",
    "test:plugins": "node --test tests/plugins/*.test.cjs",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "build:sdk": "npm --workspace packages/sdk-js run build",
    "lint": "npm --workspace apps/api run lint && npm --workspace apps/web run lint",
    "format": "prettier --write .",
    "prisma:generate": "npm --workspace apps/api run prisma:generate",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:seed": "npm --workspace apps/api run db:seed",
    "package:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-deploy.ps1",
    "package:deploy:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-deploy.ps1 -SkipBuild",
    "backup:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-full.ps1",
    "test": "npm run build:plugins && npm run test:regression && npm run test:plugins",
    "test:regression": "node --test --test-concurrency=4 tests/regression/*.test.cjs",
    "test:acceptance:browser": "node tests/acceptance/browser.cjs",
    "test:acceptance:share-ui": "node tests/acceptance/public-share-ui.cjs",
    "test:acceptance:verify": "node tests/acceptance/verify-retained.cjs",
    "test:acceptance:files": "node tests/acceptance/upload-download-share.mjs",
    "test:acceptance:lifecycle": "node tests/acceptance/lifecycle.mjs",
    "test:acceptance:cloud": "node tests/acceptance/real-cloud.cjs",
    "test:acceptance:sessions": "node tests/acceptance/auth-sessions-real.cjs",
    "test:acceptance:storage-ui": "node --test tests/acceptance/global-storage-ui.cjs",
    "test:acceptance:storage-real": "node tests/acceptance/global-storage-real.cjs",
    "test:acceptance:verify-all": "node tests/acceptance/verify-all-retained.cjs",
    "test:acceptance:replicas": "node tests/acceptance/replicated-storage-real.cjs",
    "test:acceptance:replica-browser": "node tests/acceptance/replica-browser-real.cjs",
    "test:acceptance:replica-followup": "node tests/acceptance/replica-followup-real.cjs",
    "test:acceptance:replica-video": "node tests/acceptance/replica-video-real.cjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.48.0",
    "esbuild": "^0.25.12",
    "typescript": "5.9.3"
  }
}
