{
  "name": "unified-file-manager",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Multi-project unified file management platform.",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/sdk-js"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/api run build && npm --workspace apps/web run build && npm --workspace packages/sdk-js run build",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "build:sdk": "npm --workspace packages/sdk-js run build",
    "lint": "npm --workspace apps/api run lint && npm --workspace apps/web run lint",
    "format": "prettier --write .",
    "prisma:generate": "npm --workspace apps/api run prisma:generate",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:seed": "npm --workspace apps/api run db:seed",
    "package:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-deploy.ps1",
    "package:deploy:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-deploy.ps1 -SkipBuild",
    "backup:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-full.ps1"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.48.0"
  }
}
